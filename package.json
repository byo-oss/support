{
  "name": "@byo-oss/support",
  "version": "0.1.0",
  "description": "A better-auth plugin for customer support: tickets, replies and attachments in your own database.",
  "license": "MIT",
  "author": "Jarod Stewart",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./wraps": {
      "types": "./dist/wraps.d.ts",
      "import": "./dist/wraps.js",
      "require": "./dist/wraps.cjs"
    },
    "./s3": {
      "types": "./dist/s3.d.ts",
      "import": "./dist/s3.js",
      "require": "./dist/s3.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "NOTICE",
    "llms.txt",
    "skills"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test:sql": "vitest run --config vitest.sql.config.ts",
    "test:dist": "vitest run --config vitest.dist.config.ts"
  },
  "keywords": [
    "better-auth",
    "byo",
    "support",
    "tickets",
    "helpdesk",
    "plugin",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/byo-oss/support"
  },
  "homepage": "https://github.com/byo-oss/support#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": ">=3",
    "@wraps.dev/email": ">=0.15.0",
    "better-auth": "^1.7.7",
    "react": ">=18",
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@wraps.dev/email": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "@byo-oss/core": "^0.1.0",
    "@byo-oss/mailer": "^0.1.0",
    "mailauth": "^8.0.1",
    "postal-mime": "^4.0.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@better-auth/core": "1.7.7",
    "@better-auth/kysely-adapter": "1.7.7",
    "@better-auth/memory-adapter": "1.7.7",
    "@biomejs/biome": "^2.5.15",
    "@byo-oss/notifications": "^0.8.1",
    "@electric-sql/pglite": "^0.5.10",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wraps.dev/email": "^0.15.0",
    "better-auth": "1.7.7",
    "better-call": "1.4.0",
    "happy-dom": "^21.0.3",
    "kysely": "^0.28.17",
    "kysely-pglite": "^0.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9",
    "vitest": "^4.1.10"
  }
}
